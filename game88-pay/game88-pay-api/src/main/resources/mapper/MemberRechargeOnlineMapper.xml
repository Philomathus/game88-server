<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.pay.api.mapper.MemberRechargeOnlineMapper">
    <resultMap type="tv.game88.pay.api.entity.MemberRechargeOnline" id="MemberRechargeOnlineResult">
        <result property="orderNo" column="order_no" />
        <result property="memberId" column="member_id" />
        <result property="platformId" column="platform_id" />
        <result property="channelId" column="channel_id" />
        <result property="upperOrderNo" column="upper_order_no" />
        <result property="money" column="money" />
        <result property="realMoney" column="real_money" />
        <result property="paymentAddress" column="payment_address" />
        <result property="payTime" column="pay_time" />
        <result property="status" column="status" />
        <result property="patchOrder" column="patch_order" />
        <result property="remark" column="remark" />
        <result property="updateTime" column="update_time" />
        <result property="first" column="first" />
        <result property="rate" column="rate" />
    </resultMap>

    <sql id="selectMemberRechargeOnlineVo">
        select order_no,member_id,upper_order_no,platform_id,channel_id,
               money,real_money,payment_address,pay_time,status,
               patch_order,remark,update_time, `first`, rate
        from member_recharge_online
    </sql>

    <select id="selectMemberRechargeOnlineList" parameterType="tv.game88.pay.api.entity.MemberRechargeOnline"
            resultMap="MemberRechargeOnlineResult">
        <include refid="selectMemberRechargeOnlineVo" />
        <where>
            <include refid="listWhere"/>
            <if test="downLoadDate[0] != null "> and update_time <![CDATA[ >= ]]> '${downLoadDate[0]}'</if>
            <if test="downLoadDate[1] != null "> and update_time <![CDATA[ <= ]]> '${downLoadDate[1]}'</if>
        </where>
        order by update_time desc
    </select>

    <sql id="listWhere">
        <if test="status != null and status != ''">
            and status = #{status}
        </if>
        <if test="platformId != null and platformId != ''">
            and platform_id = #{platformId}
        </if>
        <if test="searchOrderNo != null and searchOrderNo != ''">
            and (upper_order_no = #{searchOrderNo} or order_no = #{searchOrderNo})
        </if>
        <if test="searchValue != null and searchValue != ''">
            and member_id = #{searchValue}
        </if>
        <if test="selectStartDate != null and selectStartDate != ''">
            and update_time <![CDATA[ >= ]]> #{selectStartDate} and update_time <![CDATA[ <= ]]> #{selectEndDate}
        </if>
        <if test="channelName != null and channelName != ''">
            and channel_id in (SELECT id from pay_channel where name like concat(#{channelName}, '%'))
        </if>
    </sql>

    <select id="countOrder" resultType="java.util.Map">
        select `status`, COUNT(1) count
        from member_recharge_online
        where member_id = #{userId}
        and pay_time >= DATE_SUB(NOW(), INTERVAL 10 MINUTE)
        GROUP BY `status`
    </select>

    <select id="listCount" resultType="java.util.Map">
        select *, c.successCount / a.total failRate from (<include refid="transactionsTotal"/>)a
        left join (<include refid="replenishmentTotal"/>)b on 1 = 1
        left join (<include refid="successCountRate"/>)c on 1 = 1
    </select>

    <sql id="transactionsTotal">
        select count(*) total
        from member_recharge_online
        where 1=1
        <include refid="listWhere"/>
    </sql>

    <sql id="replenishmentTotal">
        select sum(real_money) replenishmentTotalMoney
        from member_recharge_online
        where 1=1
        <include refid="listWhere"/>
        and patch_order = 1
    </sql>

    <sql id="successCountRate">
        select count(*) successCount, sum(real_money) totalMoney
        from member_recharge_online
        where 1=1
        <include refid="listWhere"/>
        and status = 1
    </sql>

    <select id="selectRspDetail" resultType="tv.game88.pay.api.dto.RspWithdrawRechargeDetail">
        SELECT
        money AS money,
        order_no AS orderNo,
        pay_time requestTime,
        `status`
        FROM member_recharge_online
        WHERE member_id = #{memberId}
        and pay_time >= DATE_SUB(NOW(),INTERVAL 15 DAY)
        order by pay_time desc
    </select>

    <select id="selectMemberRechargeOnlineById" parameterType="java.lang.String" resultType="tv.game88.pay.api.entity.MemberRechargeOnline">
        <include refid="selectMemberRechargeOnlineVo" />
       Where order_no = #{id}
    </select>

</mapper>