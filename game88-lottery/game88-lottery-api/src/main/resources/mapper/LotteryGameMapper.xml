<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.lottery.api.mapper.LotteryGameMapper">
    <resultMap type="tv.game88.lottery.api.entity.LotteryGame" id="LotteryGameResult">
        <result property="id" column="id" />
        <result property="methodId" column="method_id" />
        <result property="type" column="type" />
        <result property="info" column="info" />
        <result property="odds" column="odds" />
        <result property="sort" column="sort" />
    </resultMap>

    <sql id="selectLotteryGameVo">
        select id, method_id, type, info, odds, sort
        from lottery_game
    </sql>
    <select id="selectLotteryGameList" resultType="tv.game88.lottery.api.entity.LotteryGame">
        <include refid="selectLotteryGameVo"/>
        <where>
            <if test="methodId != null  and methodId != ''"> and method_id = #{methodId}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="info != null  and info != ''"> and info = #{info}</if>
            <if test="odds != null "> and odds = #{odds}</if>
        </where>
    </select>
</mapper>