<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.lottery.api.mapper.LotteryHistoryMapper">
    <resultMap type="tv.game88.lottery.api.entity.LotteryHistory" id="LotteryHistoryResult">
        <result property="id" column="id" />
        <result property="issue" column="issue" />
        <result property="lotteryId" column="lottery_id" />
        <result property="code" column="code" />
        <result property="ktime" column="ktime" />
        <result property="status" column="status" />
        <result property="name" column="name" />
        <result property="killRate" column="kill_rate" />
        <result property="totalBet" column="total_bet" />
        <result property="totalPrize" column="total_prize" />
        <result property="ctl" column="ctl" />
        <result property="analyse" column="analyse" />
    </resultMap>

    <sql id="selectLotteryHistoryVo">
        select id,
               issue,
               lottery_id,
               code,
               ktime,
               status,
               name,
               kill_rate,
               total_bet,
               total_prize,
               ctl,
               analyse
        from lottery_history
    </sql>

    <select id="selectLotteryHistoryList" parameterType="tv.game88.lottery.api.entity.LotteryHistory" resultMap="LotteryHistoryResult">
        <include refid="selectLotteryHistoryVo"/>
        <where>
            <if test="issue != null  and issue != ''"> and issue = #{issue}</if>
            <if test="lotteryId != null "> and lottery_id = #{lotteryId}</if>
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                and date_format(ktime,'%y%m%d') <![CDATA[ >= ]]> date_format(#{params.beginTime},'%y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                and date_format(ktime,'%y%m%d') <![CDATA[ <= ]]> date_format(#{params.endTime},'%y%m%d')
            </if>
            <if test="status != null "> and status = #{status}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="killRate != null "> and kill_rate = #{killRate}</if>
            <if test="totalBet != null "> and total_bet = #{totalBet}</if>
            <if test="totalPrize != null "> and total_prize = #{totalPrize}</if>
            <if test="ctl != null "> and ctl = #{ctl}</if>
            <if test="analyse != null  and analyse != ''"> and analyse = #{analyse}</if>
        </where>
    </select>

    <select id="selectIssueWaite" resultType="java.lang.String">
        select id
        from lottery_history
        where status = 0
          and ktime &lt;= #{time}
          and lottery_id = #{lotteryId}
    </select>

    <update id="updateAlreadyPrize">
        update lottery_history
        set total_prize = #{totalPrize},
            code        = #{code},
            status      = #{status},
            kill_rate   = #{killRate},
            total_bet   = #{totalBet},
            total_prize = #{totalPrize},
            analyse     = #{analyse},
            ctl         = #{ctl}
        where id = #{id}
          and status = 0
    </update>

    <select id="selectHistoryResult" resultType="tv.game88.lottery.api.dto.HistoryResult">
        SELECT id, code
        from lottery_history
        WHERE status = #{status}
          and lottery_id = #{lotteryId}
        order by issue desc
        limit 200
    </select>

    <select id="selectResultWaite" resultType="tv.game88.lottery.api.dto.HistoryResult">
        SELECT id, code, analyse
        FROM ${lotteryAgent}.lottery_history
        WHERE id IN (select id
                     from lottery_history
                     where status = 0
                       and ktime &lt;= date_add(NOW(), interval 60 second)
                       and lottery_id = #{lotteryId})
          and status > 0
    </select>
</mapper>