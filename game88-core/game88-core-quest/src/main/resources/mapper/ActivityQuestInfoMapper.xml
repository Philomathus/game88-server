<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.core.quest.mapper.ActivityQuestInfoMapper">
    <resultMap type="tv.game88.core.quest.entity.ActivityQuestInfo" id="ActivityQuestInfoResult">
        <result property="id" column="id" />
        <result property="icon" column="icon" />
        <result property="title" column="title" />
        <result property="typeId" column="type_id" />
        <result property="gameTypeId" column="game_type_id" />
        <result property="target" column="target" />
        <result property="reward" column="reward" />
        <result property="content" column="content" />
        <result property="taskMode" column="task_mode" />
        <result property="effect" column="effect" />
        <result property="sort" column="sort" />
    </resultMap>

    <sql id="selectActivityQuestInfoVo">
        select id,
               icon,
               title,
               type_id,
               game_type_id,
               target,
               reward,
               content,
               task_mode,
               effect,
               sort
        from activity_quest_info
    </sql>

    <select id="selectActivityQuestInfoList" parameterType="tv.game88.core.quest.entity.ActivityQuestInfo"
            resultMap="ActivityQuestInfoResult">
        <include refid="selectActivityQuestInfoVo" />
        <where>
            <if test="title != null  and title != ''">
                and title like concat('%', #{title}, '%')
            </if>
            <if test="typeId != null">
                and type_id = #{typeId}
            </if>
            <if test="gameTypeId != null">
                and game_type_id = #{gameTypeId}
            </if>
            <if test="taskMode != null">
                and task_mode = #{taskMode}
            </if>
            <if test="effect != null">
                and effect = #{effect}
            </if>
        </where>
        order by sort
    </select>
</mapper>