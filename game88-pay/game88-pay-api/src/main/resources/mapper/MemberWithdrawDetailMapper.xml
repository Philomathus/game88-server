<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.pay.api.mapper.MemberWithdrawDetailMapper">
    <resultMap type="tv.game88.pay.api.entity.MemberWithdrawDetail" id="MemberWithdrawDetailResult">
        <result property="withdrawOrderNo" column="withdraw_order_no" />
        <result property="withdrawId" column="withdraw_id" />
        <result property="withdrawMoney" column="withdraw_money" />
        <result property="bankId" column="bank_id" />
        <result property="bankAccount" column="bank_account" />
        <result property="bankAddress" column="bank_address" />
        <result property="bankUserName" column="bank_user_name" />
        <result property="status" column="status" />
        <result property="memberStatus" column="member_status" />
        <result property="first" column="first" />
        <result property="opName" column="op_name" />
        <result property="remark" column="remark" />
        <result property="rechargeWithdrawRate" column="recharge_withdraw_rate" />
        <result property="bankRechargeNum" column="bank_recharge_num" />
        <result property="realBankAddress" column="real_bank_address" />
        <result property="rechargeUserName" column="recharge_user_name" />
        <result property="rechargeBcodeRate" column="recharge_bcode_rate" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectMemberWithdrawDetailVo">
        select withdraw_order_no,withdraw_id,withdraw_money,bank_id,bank_account,
               bank_address,bank_user_name,status,member_status,`first`,op_name,
               remark,recharge_withdraw_rate,bank_recharge_num,real_bank_address,
               recharge_user_name,recharge_bcode_rate,create_time,update_time
        from member_withdraw_detail
    </sql>

    <select id="selectMemberWithdrawDetailList" parameterType="tv.game88.pay.api.entity.MemberWithdrawDetail"
            resultMap="MemberWithdrawDetailResult">
        <include refid="selectMemberWithdrawDetailVo" />
        <where>
            <if test="withdrawId != null  and withdrawId != ''">
                and withdraw_id = #{withdrawId}
            </if>
            <if test="withdrawMoney != null">
                and withdraw_money = #{withdrawMoney}
            </if>
            <if test="bankId != null">
                and bank_id = #{bankId}
            </if>
            <if test="bankAccount != null  and bankAccount != ''">
                and bank_account = #{bankAccount}
            </if>
            <if test="bankAddress != null  and bankAddress != ''">
                and bank_address = #{bankAddress}
            </if>
            <if test="bankUserName != null  and bankUserName != ''">
                and bank_user_name like concat('%', #{bankUserName}, '%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
            <if test="memberStatus != null">
                and member_status = #{memberStatus}
            </if>
            <if test="first != null">
                and `first` = #{first}
            </if>
            <if test="opName != null  and opName != ''">
                and op_name like concat('%', #{opName}, '%')
            </if>
            <if test="remark != null  and remark != ''">
                and remark = #{remark}
            </if>
            <if test="rechargeWithdrawRate != null">
                and recharge_withdraw_rate = #{rechargeWithdrawRate}
            </if>
            <if test="bankRechargeNum != null">
                and bank_recharge_num = #{bankRechargeNum}
            </if>
            <if test="realBankAddress != null  and realBankAddress != ''">
                and real_bank_address = #{realBankAddress}
            </if>
            <if test="rechargeUserName != null  and rechargeUserName != ''">
                and recharge_user_name like concat('%', #{rechargeUserName}, '%')
            </if>
            <if test="rechargeBcodeRate != null">
                and recharge_bcode_rate = #{rechargeBcodeRate}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="updateTime != null">
                and update_time = #{updateTime}
            </if>
        </where>
    </select>
</mapper>