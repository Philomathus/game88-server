<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.general.api.mapper.AgentMapper">

    <resultMap type="tv.game88.general.api.entity.Agent" id="AgentResult">
        <result property="key" column="key" />
        <result property="name" column="name" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectAgentVo">
        select  `key`,
               `name`,
               `status`,
               create_by,
               create_time,
               update_by,
               update_time
        from agent
    </sql>

    <select id="selectAgentList" parameterType="tv.game88.general.api.entity.Agent" resultMap="AgentResult">
        <include refid="selectAgentVo" />
        <where>
            <if test="name != null  and name != ''">and `name` like concat('%', #{name}, '%')</if>
            <if test="key != null  and key != ''">and `key` = #{key}</if>
            <if test="status != null ">and `status` = #{status}</if>
        </where>
    </select>

    <select id="selectAllAgentList" resultMap="AgentResult">
        select key, name
        from agent
        where status = 1
    </select>
</mapper>
