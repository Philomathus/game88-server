<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.core.quest.mapper.ActivityTypeMapper">
    <resultMap type="tv.game88.core.quest.entity.ActivityType" id="ActivityTypeResult">
        <result property="id" column="id" />
        <result property="name" column="name" />
        <result property="sort" column="sort" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="selectActivityTypeVo">
        select id,
               name,
               sort,
               create_by,
               create_time
        from activity_type
    </sql>

    <select id="selectActivityTypeList" parameterType="tv.game88.core.quest.entity.ActivityType"
            resultMap="ActivityTypeResult">
        <include refid="selectActivityTypeVo" />
        <where>
            <if test="name != null  and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
        </where>
        order by sort
    </select>
</mapper>