<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="tv.game88.pay.api.mapper.BankCardAddressMapper">
    <resultMap type="tv.game88.pay.api.entity.BankCardAddress" id="BankCardAddressResult">
        <result property="id" column="id"/>
        <result property="province" column="province"/>
        <result property="city" column="city"/>
        <result property="status" column="status"/>
        <result property="createName" column="create_name"/>
    </resultMap>

    <sql id="selectBankCardAddressVo">
        select id, province, city, status, create_name from bank_card_address
    </sql>

    <select id="selectBankCardAddressList" parameterType="tv.game88.pay.api.entity.BankCardAddress" resultMap="BankCardAddressResult">
        <include refid="selectBankCardAddressVo"/>
        <where>
            <if test="status != null  and status != ''">and status = #{status}</if>
            <if test="province != null  and province != ''">and province = #{province}</if>
            <if test="city != null  and city != ''">and city = #{city}</if>
            <if test="createName != null  and createName != ''">and create_name like concat('%', #{createName}, '%')</if>
        </where>
    </select>

    <update id="updateBankCardAddress">
        update bank_card_address
        <trim prefix="SET" suffixOverrides=",">
            <if test="province != null">province = #{province},</if>

            <if test="city != null">city = #{city},</if>

            <if test="status != null">status = #{status},</if>

            <if test="createName != null">create_name = #{createName},</if>

        </trim>
        where id = #{id}
    </update>

</mapper>