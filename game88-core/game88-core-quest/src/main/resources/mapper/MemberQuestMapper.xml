<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.core.quest.mapper.MemberQuestMapper">
    <resultMap type="tv.game88.core.quest.entity.MemberQuest" id="MemberQuestResult">
        <result property="id" column="id" />
        <result property="memberId" column="member_id" />
        <result property="questId" column="quest_id" />
        <result property="status" column="status" />
        <result property="curNum" column="cur_num" />
        <result property="taskMode" column="task_mode" />
        <result property="title" column="title" />
    </resultMap>

    <sql id="selectMemberQuestVo">
        SELECT id, member_id, quest_id, status, cur_num, task_mode
        FROM member_quest
    </sql>

    <select id="selectMemberQuestList" parameterType="tv.game88.core.quest.entity.MemberQuest"
            resultMap="MemberQuestResult">
        SELECT mq.id ,mq.member_id, mq.status, mq.cur_num, aqi.target,aqi.title, mq.task_mode
        FROM member_quest mq left join
             activity_quest_info aqi on mq.quest_id = aqi.id
        <where>
            <if test="memberId != null  and memberId != ''">
                AND mq.member_id = #{memberId}
            </if>
        </where>
    </select>

    <select id="selectMemberQuestById" parameterType="java.lang.String" resultMap="MemberQuestResult">
        <include refid="selectMemberQuestVo"/>
        where id = #{id}
    </select>

    <!--    重置每日任务状态、打码量、有效时间-->
    <update id="resetDayTaskStatus">
        delete
        from member_quest
        where task_mode = 1
    </update>


    <insert id="insertMemberQuest" parameterType="tv.game88.core.quest.entity.MemberQuest">
        insert ignore into member_quest
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="memberId != null">member_id,</if>
            <if test="questId != null">quest_id,</if>
            <if test="status != null">status,</if>
            <if test="curNum != null">cur_num,</if>
            <if test="taskMode != null">task_mode,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="memberId != null">#{memberId},</if>
            <if test="questId != null">#{questId},</if>
            <if test="status != null">#{status},</if>
            <if test="curNum != null">#{curNum},</if>
            <if test="taskMode != null">#{taskMode},</if>
        </trim>
    </insert>

    <update id="updateMemberQuest" parameterType="tv.game88.core.quest.entity.MemberQuest">
        update member_quest
        <trim prefix="SET" suffixOverrides=",">
            <if test="memberId != null">member_id = #{memberId},</if>

            <if test="questId != null">quest_id = #{questId},</if>

            <if test="status != null">status = #{status},</if>

            <if test="curNum != null">cur_num = #{curNum},</if>

        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMemberQuestById" parameterType="java.lang.String">
        delete from member_quest where id = #{id}
    </delete>

    <delete id="deleteMemberQuestByIds" parameterType="java.lang.String">
        delete from member_quest where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
