<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.game.api.mapper.GameWashCodeLogMapper">
    <resultMap type="tv.game88.game.api.entity.GameWashCodeLog" id="GameWashCodeLogResult">
        <result property="washId" column="wash_id" />
        <result property="memberId" column="member_id" />
        <result property="gameTypeId" column="game_type_id" />
        <result property="codeAmount" column="code_amount" />
        <result property="washCodeRate" column="wash_code_rate" />
        <result property="washCodeAmount" column="wash_code_amount" />
        <result property="washCodeTime" column="wash_code_time" />
    </resultMap>

    <sql id="selectGameWashCodeLogVo">
        select wash_id, member_id, game_type_id, code_amount, wash_code_rate, wash_code_amount, wash_code_time
        from game_wash_code_log
    </sql>

    <select id="selectGameWashCodeLogList" parameterType="tv.game88.game.api.entity.GameWashCodeLog"
            resultMap="GameWashCodeLogResult">
        <include refid="selectGameWashCodeLogVo" />
        <where>
            <if test="memberId != null  and memberId != ''">
                and member_id = #{memberId}
            </if>
            <if test="gameTypeId != null">
                and game_type_id = #{gameTypeId}
            </if>
        </where>
    </select>

    <select id="selectRspList" resultType="tv.game88.game.api.dto.RspGameWashCodeLog">
        select w.member_id,
               w.game_type_id,
               w.code_amount,
               w.wash_code_rate,
               w.wash_code_amount,
               w.wash_code_time,
               t.name game_type_name
        from game_wash_code_log w
                 left join game_type t on t.id = w.game_type_id
        where w.member_id = #{memberId}
          and w.wash_code_time >= DATE_SUB(NOW(), INTERVAL 30 DAY)
        order by w.wash_code_time desc, w.game_type_id
    </select>
</mapper>