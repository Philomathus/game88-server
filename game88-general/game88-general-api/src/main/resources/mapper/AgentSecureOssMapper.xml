<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.general.api.mapper.AgentSecureOssMapper">

    <resultMap type="tv.game88.general.api.entity.AgentSecureOss" id="AgentSecureOssResult">
        <result property="id" column="id" />
        <result property="status" column="status" />
        <result property="agent" column="agent" />
        <result property="name" column="name" />
        <result property="accessKey" column="access_key" />
        <result property="accessSecret" column="access_secret" />
        <result property="endpoint" column="endpoint" />
        <result property="bucket" column="bucket" />
        <result property="updateTime" column="update_time" />
        <result property="updateBy" column="update_by" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="selectAgentSecureOssVo">
        select id,
               status,
               agent,
               name,
               access_key,
               access_secret,
               endpoint,
               bucket,
               update_time,
               update_by,
               create_by,
               create_time
        from agent_secure_oss
    </sql>

    <select id="selectAgentSecureOssList" parameterType="tv.game88.general.api.entity.AgentSecureOss"
            resultMap="AgentSecureOssResult">
        <include refid="selectAgentSecureOssVo" />
        <where>
            <if test="status != null ">and status = #{status}</if>
            <if test="agent != null  and agent != ''">and agent = #{agent}</if>
            <if test="name != null  and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="accessKey != null  and accessKey != ''">and access_key = #{accessKey}</if>
            <if test="accessSecret != null  and accessSecret != ''">and access_secret = #{accessSecret}</if>
            <if test="endpoint != null  and endpoint != ''">and endpoint = #{endpoint}</if>
            <if test="bucket != null  and bucket != ''">and bucket = #{bucket}</if>
        </where>
    </select>
</mapper>
