<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.wallet.api.mapper.WalletTransactionDetailMapper">

    <resultMap id="WalletTransactionDetailResult" type="tv.game88.wallet.api.entity.WalletTransactionDetail">
        <id property="transDetailId" column="trans_detail_id" jdbcType="VARCHAR" />
        <result property="transactionId" column="transaction_id" jdbcType="VARCHAR" />
        <result property="sellerId" column="seller_id" jdbcType="VARCHAR" />
        <result property="buyerId" column="buyer_id" jdbcType="VARCHAR" />
        <result property="amount" column="amount" jdbcType="BIGINT" />
        <result property="transCertPic" column="trans_cert_pic" jdbcType="VARCHAR" />
        <result property="status" column="status" />
        <result property="buyerConfirmBuyTime" column="buyer_confirm_buy_time" jdbcType="TIMESTAMP" />
        <result property="sellerConfirmTransTime" column="seller_confirm_trans_time" jdbcType="TIMESTAMP" />
        <result property="buyerConfirmTransferTime" column="buyer_confirm_transfer_time" jdbcType="TIMESTAMP" />
        <result property="cancelTime" column="cancel_time" jdbcType="TIMESTAMP" />
        <result property="successTransTime" column="success_trans_time" jdbcType="TIMESTAMP" />
        <result property="transferTimeSec" column="transfer_time_sec" jdbcType="INTEGER" />
        <result property="receivedTimeSec" column="received_time_sec" jdbcType="INTEGER" />
        <result property="remark" column="remark" jdbcType="VARCHAR" />
    </resultMap>

    <sql id="selectWalletTransactionDetailVo">
        select trans_detail_id,
               transaction_id,
               seller_id,
               buyer_id,
               amount,
               trans_cert_pic,
               status,
               buyer_confirm_buy_time,
               seller_confirm_trans_time,
               buyer_confirm_transfer_time,
               cancel_time,
               success_trans_time,
               transfer_time_sec,
               received_time_sec,
               remark
        from wallet_transaction_detail
    </sql>
</mapper>
