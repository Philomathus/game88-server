<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.lottery.api.mapper.LotteryMethodMapper">
    <resultMap type="tv.game88.lottery.api.entity.LotteryMethod" id="LotteryMethodResult">
        <result property="id" column="id" />
        <result property="lotteryType" column="lottery_type" />
        <result property="name" column="name" />
        <result property="sort" column="sort" />
    </resultMap>

    <sql id="selectLotteryMethodVo">
        select id,lottery_type,name,sort from lottery_method
    </sql>
    <select id="selectLotteryMethodList" parameterType="tv.game88.lottery.api.entity.LotteryMethod" resultMap="LotteryMethodResult">
        <include refid="selectLotteryMethodVo"/>
        <where>
            <if test="lotteryType != null  and lotteryType != ''"> and lottery_type = #{lotteryType}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
        </where>
    </select>
</mapper>