<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.platform.api.mapper.MobileLimitMapper">
    <resultMap type="tv.game88.platform.api.entity.MobileLimit" id="MobileLimitResult">
        <result property="mobile" column="mobile" />
    </resultMap>

    <sql id="selectMobileLimitVo">
        select mobile
        from mobile_limit
    </sql>

    <select id="selectMobileLimitList" parameterType="tv.game88.platform.api.entity.MobileLimit"
            resultMap="MobileLimitResult">
        <include refid="selectMobileLimitVo" />
        <where>
            <if test="mobile != null  and mobile != ''">
                and mobile like concat(#{mobile}, '%')
            </if>
        </where>
    </select>
</mapper>