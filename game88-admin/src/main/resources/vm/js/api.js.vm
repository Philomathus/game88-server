import request from '@/utils/request'
import {url} from '@/utils/url'

// 查询${functionName}列表
export function list${BusinessName}(query) {
  return request({
    url: url.game88AdminWeb + '/${moduleName}/${businessName}/list',
    method: 'get',
    params: query
  })
}

// 查询${functionName}详细
export function get${BusinessName}(${pkColumn.javaField}) {
  return request({
    url: url.game88AdminWeb + '/${moduleName}/${businessName}/' + ${pkColumn.javaField},
    method: 'get'
  })
}

// 新增${functionName}
export function add${BusinessName}(data) {
  return request({
    url: url.game88AdminWeb + '/${moduleName}/${businessName}',
    method: 'post',
    data: data
  })
}

// 修改${functionName}
export function update${BusinessName}(data) {
  return request({
    url: url.game88AdminWeb + '/${moduleName}/${businessName}',
    method: 'put',
    data: data
  })
}

// 删除${functionName}
export function del${BusinessName}(${pkColumn.javaField}) {
  return request({
    url: url.game88AdminWeb + '/${moduleName}/${businessName}/' + ${pkColumn.javaField},
    method: 'delete'
  })
}

// 导出${functionName}
export function export${BusinessName}(query) {
  return request({
    url: url.game88AdminWeb + '/${moduleName}/${businessName}/export',
    method: 'get',
    params: query,
    responseType: 'arraybuffer',
    timeout: 60000
  })
}
