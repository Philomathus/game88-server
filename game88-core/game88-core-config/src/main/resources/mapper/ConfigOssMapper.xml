<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.core.config.mapper.ConfigOssMapper">
	<resultMap type="tv.game88.core.config.entity.ConfigOss" id="ConfigOssResult">
		<result property="id" column="id"/>
		<result property="name" column="name"/>
		<result property="accessKey" column="access_key"/>
		<result property="accessSecret" column="access_secret"/>
		<result property="endpoint" column="endpoint"/>
		<result property="bucket" column="bucket"/>
		<result property="vhost" column="vhost"/>
		<result property="isEffect" column="is_effect"/>
		<result property="provider" column="provider"/>
		<result property="doMain" column="do_main"/>
		<result property="createBy" column="create_by"/>
		<result property="createTime" column="create_time"/>
		<result property="updateBy" column="update_by"/>
		<result property="updateTime" column="update_time"/>
		<result property="remark" column="remark"/>
	</resultMap>

	<sql id="selectConfigOssVo">
		select id,
			   name,
			   access_key,
			   access_secret,
			   endpoint,
			   bucket,
			   vhost,
			   is_effect,
		       provider,
		       do_main,
			   create_by,
			   create_time,
			   update_by,
			   update_time,
			   remark
		from config_oss
	</sql>

	<select id="selectConfigOssList" parameterType="tv.game88.core.config.entity.ConfigOss" resultMap="ConfigOssResult">
		<include refid="selectConfigOssVo"/>
		<where>
			<if test="name != null  and name != ''">
				and name like concat('%', #{name}, '%')
			</if>
		</where>
	</select>

	<select id="selectConfigOssByEffect" resultMap="ConfigOssResult">
		<include refid="selectConfigOssVo"/>
		where is_effect = 1
	</select>
</mapper>
