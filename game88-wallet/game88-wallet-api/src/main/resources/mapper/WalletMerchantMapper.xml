<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.wallet.api.mapper.WalletMerchantMapper">

    <resultMap id="WalletMerchantResult" type="tv.game88.wallet.api.entity.WalletMerchant">
        <id property="id" column="id" jdbcType="BIGINT" />
        <result property="name" column="name" jdbcType="VARCHAR" />
        <result property="account" column="account" jdbcType="VARCHAR" />
        <result property="password" column="password" jdbcType="VARCHAR" />
        <result property="secretKey" column="secret_key" jdbcType="VARCHAR" />
        <result property="md5Key" column="md5_key" jdbcType="VARCHAR" />
        <result property="status" column="status" jdbcType="INTEGER" />
        <result property="email" column="email" jdbcType="VARCHAR" />
        <result property="phone" column="phone" jdbcType="VARCHAR" />
        <result property="amount" column="amount" jdbcType="DECIMAL" />
        <result property="frozenAmount" column="frozen_amount" jdbcType="DECIMAL" />
        <result property="loginIp" column="login_ip" jdbcType="VARCHAR" />
        <result property="loginTime" column="login_time" jdbcType="TIMESTAMP" />
        <result property="createdTime" column="created_time" jdbcType="TIMESTAMP" />
        <result property="updatedTime" column="updated_time" jdbcType="TIMESTAMP" />
        <result property="remark" column="remark" jdbcType="VARCHAR" />
    </resultMap>

    <sql id="selectWalletMerchantVo">
        select id,
               name,
               account,
               password,
               secret_key,
               md5_key,
               status,
               email,
               phone,
               amount,
               frozen_amount,
               login_ip,
               login_time,
               created_time,
               updated_time,
               remark
        from wallet_merchant
    </sql>

    <select id="getMerchantMoney" resultType="java.math.BigDecimal">
        select amount
        from wallet_merchant
        where id = #{merchantId}
    </select>

    <update id="reduceMoney">
        update wallet_merchant
        set amount = amount - #{money}
        where id = #{merchantId}
          and amount - #{money} >= 0
    </update>

    <update id="addMoney">
        update wallet_merchant
        set amount = amount + #{money}
        where id = #{merchantId}
    </update>
</mapper>
