<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.wallet.api.mapper.WalletUserPayMethodMapper">
    <resultMap id="WalletUserPayMethodResult" type="tv.game88.wallet.api.entity.WalletUserPayMethod">
        <id property="methodId" column="method_id" jdbcType="BIGINT" />
        <result property="methodType" column="method_type" />
        <result property="userId" column="user_id" jdbcType="VARCHAR" />
        <result property="realName" column="real_name" jdbcType="VARCHAR" />
        <result property="bankAccount" column="bank_account" jdbcType="VARCHAR" />
        <result property="bankId" column="bank_id" jdbcType="BIGINT" />
        <result property="payAddrProvince" column="pay_addr_province" jdbcType="VARCHAR" />
        <result property="payAddrCity" column="pay_addr_city" jdbcType="VARCHAR" />
        <result property="payPicAddr" column="pay_pic_addr" jdbcType="VARCHAR" />
        <result property="auditStatus" column="audit_status" jdbcType="TINYINT" />
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" />
    </resultMap>

    <sql id="selectWalletUserPayMethodVo">
        select method_id,
               method_type,
               user_id,
               real_name,
               bank_account,
               bank_id,
               pay_addr_province,
               pay_pic_addr,
               pay_addr_city,
               audit_status,
               create_time
        from wallet_user_pay_method
    </sql>
    <select id="selectWalletUserPayMethod" parameterType="tv.game88.wallet.api.entity.WalletUserPayMethod"
            resultMap="WalletUserPayMethodResult">
        select
            wupm.method_id,
            wupm.method_type,
            wupm.user_id,
            wupm.real_name,
            wupm.bank_account,
            wupm.bank_id,
            wupm.pay_addr_province,
            wupm.pay_pic_addr,
            wupm.pay_addr_city,
            wupm.audit_status,
            wupm.create_time,
            cbl.bank_name
        from wallet_user_pay_method wupm
        inner join config_bank_list cbl on cbl.id = wupm.bank_id
        <where>
            <if test="methodId != null  and methodId != ''"> and wupm.method_id = #{methodId}</if>
            <if test="realName != null  and realName != ''"> and wupm.real_name like concat('%', #{realName}, '%')</if>
            <if test="userId != null  and userId != ''"> and wupm.user_id = #{userId}</if>
            <if test="methodType != null  and methodType.name() != ''"> and wupm.method_type = #{methodType}</if>
            <if test="auditStatus != null"> and wupm.audit_status = #{auditStatus}</if>
            <if test="auditStatus == null ">  and audit_status = 1 or audit_status = 0 </if>
        </where>
        order by wupm.create_time desc
    </select>
    <select id="selectMemberCard" resultType="tv.game88.wallet.api.entity.WalletUserPayMethod">
        <include refid="selectWalletUserPayMethodVo" />
        where user_id = #{userId}
        and audit_status = 1
    </select>
</mapper>
