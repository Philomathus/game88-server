<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.core.quest.mapper.MemberQuestMapper">
    <resultMap type="tv.game88.core.quest.entity.MemberQuest" id="MemberQuestResult">
        <result property="id" column="id" />
        <result property="memberId" column="member_id" />
        <result property="questId" column="quest_id" />
        <result property="status" column="status" />
        <result property="curNum" column="curNum" />
        <result property="taskMode" column="task_mode" />
    </resultMap>

    <sql id="selectMemberQuestVo">
        SELECT id, member_id, quest_id, status, curNum, task_mode
        FROM member_quest
    </sql>

    <select id="selectMemberQuestList" parameterType="tv.game88.core.quest.entity.MemberQuest"
            resultMap="MemberQuestResult">
        SELECT mq.id, mq.member_id, mq.status, mq.curNum, aqi.target, mq.task_mode
        FROM member_quest mq,
             activity_quest_info aqi
        <where>
            mq.quest_id = aqi.id
            <if test="memberId != null  and memberId != ''">
                AND mq.member_id = #{memberId}
            </if>
        </where>
    </select>

    <!--    重置每日任务状态、打码量、有效时间-->
    <update id="resetDayTaskStatus">
        delete
        from member_quest
        where task_mode = 1
    </update>
</mapper>
