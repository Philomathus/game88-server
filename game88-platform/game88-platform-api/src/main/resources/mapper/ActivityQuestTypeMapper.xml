<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tv.game88.platform.api.mapper.ActivityQuestTypeMapper">
    <resultMap type="tv.game88.platform.api.entity.ActivityQuestType" id="ActivityQuestTypeResult">
        <result property="id" column="id" />
        <result property="name" column="name" />
        <result property="sort" column="sort" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="gameId" column="game_id" />
    </resultMap>

    <sql id="selectActivityQuestTypeVo">
        select id,
               name,
               sort,
               create_by,
               create_time,
               game_id
        from activity_quest_type
    </sql>

    <select id="selectActivityQuestTypeList" parameterType="tv.game88.platform.api.entity.ActivityQuestType"
            resultMap="ActivityQuestTypeResult">
        <include refid="selectActivityQuestTypeVo" />
        <where>
            <if test="name != null  and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="sort != null">
                and sort = #{sort}
            </if>
            <if test="createBy != null  and createBy != ''">
                and create_by = #{createBy}
            </if>
            <if test="createTime != null">
                and create_time = #{createTime}
            </if>
            <if test="gameId != null">
                and game_id = #{gameId}
            </if>
        </where>
        order by sort
    </select>
</mapper>